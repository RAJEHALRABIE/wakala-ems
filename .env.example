# ═══════════════════════════════════════════════════════════════
# Wakala EMS - Environment Variables Template
# نظام وكالة EMS - قالب متغيرات البيئة
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# DATABASE | قاعدة البيانات
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/wakala_ems

# Docker MySQL Configuration (used in docker-compose)
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=wakala_ems
DB_USER=wakala_user
DB_PASSWORD=change_me_password

# ─────────────────────────────────────────────────────────────────
# AUTHENTICATION | المصادقة
# ─────────────────────────────────────────────────────────────────
# JWT Secret (minimum 32 characters)
JWT_SECRET=your-secret-key-minimum-32-characters-here

# Access Code for Login (shown on login page)
LOGIN_ACCESS_CODE=BAREQ2030

# Master Key for Admin Operations (delete, sensitive settings)
MASTER_KEY=RAJ0579

# ─────────────────────────────────────────────────────────────────
# MANUS OAUTH (Required if using Manus platform)
# مصادقة Manus (مطلوب إذا كنت تستخدم منصة Manus)
# ─────────────────────────────────────────────────────────────────
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# ─────────────────────────────────────────────────────────────────
# MANUS FORGE API (Required for Maps and AI features)
# ─────────────────────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=sk-your-server-api-key
VITE_FRONTEND_FORGE_API_KEY=pk-your-frontend-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai

# ─────────────────────────────────────────────────────────────────
# GOOGLE MAPS API (Optional - for interactive maps)
# ─────────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────────────────────────────────────────────────────────
# S3 STORAGE (Optional - for document uploads)
# التخزين السحابي (اختياري - لرفع المستندات)
# ─────────────────────────────────────────────────────────────────
# إذا تركت هذه الحقول فارغة، سيُستخدم التخزين المحلي (uploads/)
# If left empty, local storage (uploads/) will be used

# === AWS S3 ===
# S3_BUCKET=your-bucket-name
# S3_REGION=me-south-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# === Cloudflare R2 (Recommended - أرخص وأسرع) ===
# S3_BUCKET=your-r2-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-r2-access-key
# S3_SECRET_ACCESS_KEY=your-r2-secret-key
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://your-custom-domain.com

# ─────────────────────────────────────────────────────────────────
# APPLICATION | التطبيق
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Owner Configuration (First user to login becomes owner)
OWNER_OPEN_ID=
OWNER_NAME=
